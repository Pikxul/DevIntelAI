{
  "name": "devintelai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered DevOps platform — VS Code Extension + SaaS",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "webhook:simulate": "node scripts/simulate-webhook.js",
    "clean": "turbo clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "mcp:playwright": "npx @playwright/mcp@latest --port 8931 --browser chrome --save-session --output-dir ./apps/web/e2e-results/mcp-sessions"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
