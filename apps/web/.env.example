# Vercel Deployment Instructions
# For local development, copy this to `.env.local` or `.env`.
# For Vercel production, add these variables in the Vercel dashboard.

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-production-url.vercel.app
NEXTAUTH_SECRET=                   # openssl rand -base64 32
AUTH_SECRET=                       # same as NEXTAUTH_SECRET (NextAuth v5 alias)

# ── GitHub OAuth (required for production login) ──────────────────────────────
GITHUB_CLIENT_ID=                  # GitHub OAuth App → Client ID
GITHUB_CLIENT_SECRET=              # GitHub OAuth App → Client Secret

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NestJS API Backend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api-production-url.up.railway.app

# ── Dev bypass (set to true only in local dev when OAuth is not configured) ───
NEXTAUTH_DEV_BYPASS=false

# ── GitHub Webhook Settings (set to true to bypass signature verification in local development) ───
GITHUB_WEBHOOK_SKIP_VALIDATION=false
