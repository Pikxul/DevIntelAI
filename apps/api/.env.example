# DevIntel AI — NestJS Backend (.env.example)

# ─── Server Configuration ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001

# ─── Security & Cryptographic Keys ───────────────────────────────────────────
# Secret used for verifying JWTs issued by NextAuth / web frontend
JWT_SECRET=your-32-byte-base64-or-hex-jwt-secret

# AES-256-CBC encryption key (MUST be exactly 32 characters) for credentials at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Secret for verifying incoming telemetry & incident ingestion webhooks (HMAC-SHA256)
INCIDENT_WEBHOOK_SECRET=your-incident-webhook-secret

# ─── Database & Redis ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aidevops:aidevops@localhost:5432/aidevops
POSTGRES_USER=aidevops
POSTGRES_PASSWORD=aidevops
POSTGRES_DB=aidevops
TYPEORM_SYNC=false

REDIS_URL=redis://localhost:6379

# ─── GitHub App Integration ──────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_NAME=devintelai
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SKIP_VALIDATION=false

# ─── AI Providers ────────────────────────────────────────────────────────────
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
