# ╔════════════════════════════════════════════════════════════════════════════╗
# ║              DevIntel AI Platform — Environment Variables                 ║
# ║                                                                           ║
# ║  Copy this file to .env and fill in your values:                          ║
# ║    cp .env.example .env                                                   ║
# ║                                                                           ║
# ║  ⚠ NEVER commit .env to source control (.gitignore already excludes it)  ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ─── AI Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=                            # OpenAI API key (sk-proj-...)
GEMINI_API_KEY=                            # Google AI Studio / Vertex key
ANTHROPIC_API_KEY=                         # Anthropic API key
AI_PRIMARY_PROVIDER=gemini                 # gemini | openai | anthropic
AI_MODEL_GEMINI=gemini-2.0-flash
AI_MODEL_OPENAI=gpt-4o
AI_MODEL_ANTHROPIC=claude-3-5-sonnet-20241022

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aidevops:aidevops@localhost:5432/aidevops
POSTGRES_USER=aidevops
POSTGRES_PASSWORD=aidevops
POSTGRES_DB=aidevops
TYPEORM_SYNC=true                          # false in production — use migrations

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Security & Cryptographic Keys ───────────────────────────────────────────
# AES-256-CBC encryption key — MUST be exactly 32 characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# JWT signing secret (base64 or hex, ≥32 bytes recommended)
JWT_SECRET=

# NextAuth secret (used by the web frontend)
AUTH_SECRET=
NEXTAUTH_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                          # Google Cloud Console → Credentials
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── GitHub Integration ───────────────────────────────────────────────────────
GITHUB_CLIENT_ID=                          # GitHub OAuth App → Client ID
GITHUB_CLIENT_SECRET=                      # GitHub OAuth App → Client Secret
GITHUB_APP_ID=                             # GitHub App → App ID (numeric)
GITHUB_APP_NAME=devintelai                 # GitHub App slug
NEXT_PUBLIC_GITHUB_APP_NAME=devintelai
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=                     # Webhook HMAC-SHA256 secret
GITHUB_TOKEN=                              # Personal access token (for API calls)
GITHUB_WEBHOOK_SKIP_VALIDATION=true        # true for local dev only

# ─── GitLab Integration ───────────────────────────────────────────────────────
GITLAB_WEBHOOK_SECRET=

# ─── Docker Registry ──────────────────────────────────────────────────────────
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=
DOCKER_PASSWORD=

# ─── Slack Notifications ──────────────────────────────────────────────────────
SLACK_BOT_TOKEN=                           # xoxb-...
SLACK_CHANNEL_ID=                          # C...
SLACK_WEBHOOK_URL=

# ─── Microsoft Teams Notifications ────────────────────────────────────────────
TEAMS_WEBHOOK_URL=

# ─── Jira Notifications ───────────────────────────────────────────────────────
JIRA_BASE_URL=                             # e.g. https://yourorg.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=                          # e.g. OPS

# ─── Email (SMTP) Notifications ───────────────────────────────────────────────
SMTP_HOST=                                 # e.g. smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=                                # e.g. noreply@yourdomain.com

# ─── SonarCloud ───────────────────────────────────────────────────────────────
SONAR_TOKEN=
SONAR_ORG=
SONAR_PROJECT_KEY=

# ─── API Backend ──────────────────────────────────────────────────────────────
PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXTAUTH_DEV_BYPASS=false                  # NEVER true in production

# ─── VS Code Extension ────────────────────────────────────────────────────────
VSCODE_API_ENDPOINT=http://localhost:3001
VSCODE_API_TOKEN=

# ─── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3030
GRAFANA_API_KEY=
